# ── API Server environment variables ────────────────────────────────────────
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (from Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk secret key (from https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack keys (from https://dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server port (defaults to 8080)
PORT=8080

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# Node environment
NODE_ENV=development

# Local development upload storage. When PRIVATE_OBJECT_DIR is unset, uploads
# are stored here instead of using the Replit object-storage sidecar.
# LOCAL_UPLOAD_DIR=./local-uploads

# Cloudflare R2 (preferred for durable Render uploads). Configure all four to
# store new uploads in R2. If unset, development falls back to local disk.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Cloudflare R2 (preferred for durable Render uploads). When all four values
# are configured, new uploads are stored in R2 instead of local disk.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Resend transactional notification email. Verify updates.afrlance.com in
# Resend first, then use a sender address on that verified domain.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Afrlance <notifications@updates.afrlance.com>"
# AFRLANCE_APP_URL=https://afrlance.com
